@article{REWARDLENS,
  abbr={Working Paper},
  bibtex_show={true},
  title={RewardLens: Same Static Accuracy, Different Intervention Behavior in Multimodal Judges},
  author = {He, Sherry Xinyao and Lai, Jianming},
  abstract={Can similar static preference scores conceal different responses to changing visual evidence? RewardLens compares multimodal judges matched by independent static accuracy on a separate controlled CLEVR audit. Questions and candidate contents stay fixed; relevant edits reverse the programmed gold preference, whereas irrelevant edits preserve it. Relevant Adaptation (RA) and Irrelevant Invariance (II) measure edited-image correctness conditional on a correct base decision. Across eight judges, a same-domain Count comparison provides a concrete counterexample: Qwen and Skywork score $100.0\%$ and $99.5\%$ on independent CLEVR static items, but their RA is $34/200$ versus $125/199$. On a separate 20-triplet order subset, both are base-correct in both orientations; the contrast persists after exchanging A/B contents ($3/20$ versus $13/20$). The complete one-point same-domain census is heterogeneous: among 42 matched pairs, 16 have RA gaps of at least 10 percentage points and 16 have zero gap, with a median of 2 points. A post-freeze two-person audit of 320 triplets finds stronger human/gold agreement for Count and Attribute than Presence and Spatial. A scene-level recheck reproduces all 960 sampled gold labels, but human disagreement is strongly associated with candidate order in the latter factors; its cause remains unresolved. RewardLens thus exposes specific behavioral differences missed by measured static scores, not universal separation, population equivalence, or a position-independent account of visual grounding.},
  journal={Working Paper},
  year={2026}
}

