<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-md-12">
          <h6 class="title ml-1 ml-md-4">
            {% if content.icon %}
              <i class="{{ content.icon }}"></i>
            {% endif %}
            {{ content.name }}
          </h6>

          {% if content.items %}
            <ul class="ml-4" style="margin-top: 0.25rem;">
              {% for item in content.items %}
                <li style="font-size: 0.95rem;">
                  {{ item.name }}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>